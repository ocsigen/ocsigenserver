== Entity_tag.parse_list
"*" -> *
" * " -> *
"\"a\"" -> "a"
"W/\"a\", \"b\",\"c\"" -> W/"a" "b" "c"
"\"a\"" | "W/\"b\"" -> "a" W/"b"
"*" | "\"a\"" -> "a"
"\"a,b\", \"c\"" -> "a,b" "c"
"\"\"" -> ""
"" -> 
"a, \"b\"" -> "b"
"\"unterminated" -> 
"w/\"a\"" -> 
"\"a\"x, \"b\"" -> "b"
"\"a\" , \"b\" " -> "a" "b"
== Entity_tag comparisons
"1" "1": weak true, strong true
"1" W/"1": weak true, strong false
W/"1" W/"1": weak true, strong false
"1" "2": weak false, strong false
